        "name": "Raju Kumar",
        "category": "farmer",
        "language_pref": "hi",
        "loan_amount": 25000,
        "loan_start_date": "2025-01-15",
        "phone_number": "+91XXXXXXXXXX"
      },
      "response_404": {
        "error": "borrower_not_found",
        "message": "No borrower exists with the supplied ID.",
        "status_code": 404
      }
    },

    "GET /borrowers": {
      "description": "Returns borrowers for the dashboard table with optional filtering.",
      "owner": "Backend Support",
      "query_params": {
        "category": "optional: farmer|gig_worker|vendor",
        "risk_flag": "optional: lean_season|normal|festival_slow",
        "hardship_classification": "optional: temporary|persistent|undetermined"
      },
      "response_200": {
        "count": 87,
        "borrowers": [
          {
            "borrower_id": "BOR001",
            "name": "Raju Kumar",
            "trust_score": 72,
            "current_flag": "normal",
            "upcoming_flag": "lean_season",
            "upcoming_flag_month": "Oct",
            "hardship_classification": "temporary"
          }
        ]
      }
    },

    "GET /borrower/{id}/score": {
