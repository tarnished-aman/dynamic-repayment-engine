    "POST /borrower/{id}/payment-plan/override": {
      "description": "Allows a loan officer to manually override the current adjusted payment plan for an escalated case.",
      "owner": "Backend Support",
      "path_params": {
        "id": "string"
      },
      "request_body": {
        "new_schedule": "array of payment schedule objects",
        "officer_note": "string"
      },
      "response_200": {
        "status": "updated",
        "updated_at": "2026-09-16T12:00:00Z",
        "updated_by": "loan_officer"
      },
      "response_404": {
        "error": "borrower_not_found",
        "message": "No borrower exists with the supplied ID.",
        "status_code": 404
      },
      "response_400": {
        "error": "invalid_payment_schedule",
        "message": "The supplied payment schedule is invalid.",
        "status_code": 400
      }
    }
  },

  "decision_logic": {
    "cashflow_analysis": {
      "history_window_months": 12,
      "inputs": [
        "income_history",
        "expense_history",
        "repayment_history"
      ]
    },

    "seasonality_detection": {
      "description": "Detects recurring borrower-specific income and repayment patterns rather than assuming risk solely from borrower category.",
      "minimum_history_months": 12,
      "lookahead_months": 3
    },

    "risk_flag_semantics": {
      "current_flag": "A risk condition that is active during the current period.",
      "upcoming_flag": "The next relevant risk condition expected within the configured lookahead window.",
      "upcoming_flag_month": "The month in which the upcoming risk window begins.",
      "flagged_months": "All months belonging to the detected risk window."
    },

    "temporary_hardship": {
      "conditions": [
        "income_drop_detected",
        "seasonality_detected == true",
        "repayment_consistency >= configured_repayment_consistency_threshold"
      ],
      "result": "temporary"
    },

    "persistent_deterioration": {
      "conditions": [
        "income_decline_duration >= configured_months",
        "repayment_consistency < configured_repayment_consistency_threshold",
        "seasonality_detected == false"
      ],
      "result": "persistent"
    },

    "undetermined_hardship": {
      "conditions": [
        "available_evidence_is_insufficient",
        "or_temporary_and_persistent_conditions_are_not_satisfied"
      ],
      "result": "undetermined"
    },

    "seasonal_match": {
      "conditions": [
        "reported_hardship_is_relevant_to_current_or_upcoming_risk_window"
      ],
      "match_types": ["current", "upcoming", "none"]
    },

    "auto_relief": {
      "conditions": [
        "intent == emergency",
        "intent_confidence >= configured_intent_confidence_threshold",
        "matched_seasonal_flag == true",
        "hardship_classification == temporary"
      ],
      "result": "auto_relief"
    },

    "escalation": {
      "conditions": [
        "intent == emergency",
        "intent_confidence < configured_intent_confidence_threshold",
        "or hardship_classification == undetermined",
        "or evidence_is_conflicting"
      ],
      "result": "escalated"
    },

    "no_action": {
      "conditions": [
        "intent == no_emergency",
        "or no_action_is_required"
      ],
      "result": "none"
    },

    "fallback": {
      "claude_api_failure_action": "escalated"
    }
  },

  "configuration": {
    "history_window_months": 12,
    "seasonality_minimum_history_months": 12,
    "seasonality_lookahead_months": 3,
    "intent_confidence_threshold": "configured_value",
    "repayment_consistency_threshold": "configured_value",
    "persistent_decline_duration_months": "configured_value"
  },

  "shared_enums": {
    "borrower_category": ["farmer", "gig_worker", "vendor"],

    "risk_flag": ["lean_season", "normal", "festival_slow"],

    "intent": ["emergency", "no_emergency"],

    "action_taken": ["auto_relief", "escalated", "none"],

    "cashflow_status": ["healthy", "temporary_stress", "persistent_deterioration"],

    "hardship_classification": ["temporary", "persistent", "undetermined"],

    "trend_direction": ["improving", "stable", "declining"],

    "seasonal_match_type": ["current", "upcoming", "none"],

    "payment_status": ["pending", "paid", "deferred", "added", "overdue"],

    "score_band": ["low_trust", "medium_trust", "high_trust"]
  },

  "shared_data_shapes": {
    "payment_schedule_item": {
      "due_date": "YYYY-MM-DD",
      "amount": "number",
      "status": "payment_status"
    },

    "borrower_summary": {
      "borrower_id": "string",
      "name": "string",
      "trust_score": "number",
      "current_flag": "risk_flag",
      "upcoming_flag": "risk_flag or null",
      "upcoming_flag_month": "string or null",
      "hardship_classification": "hardship_classification"
    }
  },

  "error_format_standard": {
    "error": "short_snake_case_code",
    "message": "human readable explanation",
    "status_code": "HTTP status code"
  },

  "error_status_codes": {
    "400": "Bad request or invalid input",
    "404": "Borrower or requested resource not found",
    "422": "Request is valid but available data is insufficient for the requested analysis",
    "500": "Internal or external service failure"
  },

