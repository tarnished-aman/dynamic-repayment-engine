{
  "project": "Dynamic Risk & Repayment Engine - API Contract v3",
  "version": "3.0",
  "base_url": "http://localhost:8000",
  "note": "Single source of truth. Changes require full team approval before modification.",
  "prototype_note": "This contract defines a hackathon prototype. Automated actions are prototype decision outputs and should not be interpreted as production lending decisions.",

  "endpoints": {
    "GET /borrower/{id}": {
      "description": "Returns the basic borrower profile.",
      "owner": "Backend Support",
