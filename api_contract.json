    "backend_lead": [
      "GET /borrower/{id}/score",
      "GET /borrower/{id}/cashflow-history",
      "GET /borrower/{id}/cashflow-analysis",
      "GET /borrower/{id}/risk-flags",
      "POST /chat/message",
      "GET /chat/history/{borrower_id}",
      "GET /borrower/{id}/assessment",
      "trust_score_logic",
      "cashflow_analysis",
      "seasonality_detection",
      "decision_engine",
      "claude_integration"
    ],

    "backend_support": [
      "GET /borrower/{id}",
      "GET /borrowers",
      "GET /borrower/{id}/payment-plan",
      "POST /borrower/{id}/payment-plan/override",
      "borrower_data_storage",
      "payment_schedule_storage"
    ],

    "frontend_lead": [
      "dashboard",
      "routing",
      "API_integration",
      "state_management",
      "borrower_selection",
      "chat_interface",
      "final_integration"
    ],

    "frontend_support": [
      "TrustScoreCard",
      "CashFlowChart",
      "CashFlowStatusCard",
      "RiskCard",
      "AssessmentCard",
      "EvidenceList",
      "PaymentPlanTable",
      "BorrowerTable",
      "StatusBadge",
      "reusable_UI_components"
    ]
  },

  "integration_flow": {
    "step_1": "Frontend requests borrower information.",
    "step_2": "Backend returns borrower profile, trust score, cash-flow data, risk flags and payment plan.",
    "step_3": "Borrower sends a text or voice-derived message.",
    "step_4": "Backend Lead processes the message using Claude/NLP.",
    "step_5": "Cash-flow analysis and borrower-specific seasonality are checked.",
    "step_6": "Decision engine combines message intent, confidence, seasonal match and hardship classification.",
    "step_7": "System returns auto_relief, escalated or none.",
    "step_8": "If auto_relief is triggered, the payment plan is updated through the backend payment-plan service.",
    "step_9": "Conversation and decision information are stored for audit history.",
    "step_10": "Frontend refreshes the assessment and payment-plan information."
  },

