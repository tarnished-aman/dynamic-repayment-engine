        "id": "string"
      },
      "response_200": {
        "borrower_id": "BOR001",
        "trust_score": 72,
        "score_band": "medium_trust",
        "score_factors": [
          {
            "factor": "utility_payments_ontime",
            "weight": 0.4,
            "value": 0.85
          },
          {
            "factor": "supplier_payments_consistent",
            "weight": 0.3,
            "value": 0.6
          },
          {
            "factor": "mobile_topup_frequency",
            "weight": 0.3,
            "value": 0.7
          }
        ],
        "last_updated": "2026-09-10"
      },
      "response_404": {
        "error": "borrower_not_found",
        "message": "No borrower exists with the supplied ID.",
        "status_code": 404
      }
    },

    "GET /borrower/{id}/cashflow-history": {
      "description": "Returns historical borrower-level financial records used for trend and seasonality analysis.",
      "owner": "Backend Lead",
      "path_params": {
        "id": "string"
      },
      "response_200": {
        "borrower_id": "BOR001",
        "history_window_months": 12,
        "monthly_history": [
          {
            "month": "2026-01",
            "income": 18000,
            "expenses": 12000,
            "loan_repayment": 2500
          },
          {
            "month": "2026-02",
            "income": 19000,
            "expenses": 12500,
            "loan_repayment": 2500
          }
        ]
      },
      "response_404": {
        "error": "borrower_not_found",
        "message": "No borrower exists with the supplied ID.",
        "status_code": 404
      }
    },

    "GET /borrower/{id}/cashflow-analysis": {
      "description": "Analyzes historical income, expenses and repayment behavior to distinguish temporary hardship from persistent deterioration and detect borrower-specific seasonality.",
      "owner": "Backend Lead",
      "path_params": {
        "id": "string"
      },
      "response_200": {
        "borrower_id": "BOR001",
        "cashflow_status": "temporary_stress",
        "trend_direction": "stable",
        "income_change_pct": -18.2,
        "expense_change_pct": 3.1,
        "repayment_consistency": 0.94,
        "seasonality_detected": true,
        "seasonal_pattern": {
          "low_income_months": ["Oct", "Nov"],
          "high_income_months": ["Jan", "Feb"]
        },
        "hardship_classification": "temporary",
        "confidence": 0.88,
        "evidence": [
          "Income declined 18.2% versus the 12-month average",
          "A similar decline was observed during Oct-Nov in previous years",
          "Repayments remained largely consistent"
        ],
        "last_updated": "2026-09-16"
      },
      "response_404": {
        "error": "borrower_not_found",
        "message": "No borrower exists with the supplied ID.",
        "status_code": 404
      }
    },

    "GET /borrower/{id}/risk-flags": {
      "description": "Returns current and upcoming risk flags derived from borrower-specific historical cash-flow behavior and detected seasonal patterns.",
      "owner": "Backend Lead",
      "path_params": {
        "id": "string"
      },
      "response_200": {
        "borrower_id": "BOR001",
        "analysis_basis": "borrower_history",
        "current_flag": "normal",
        "upcoming_flag": "lean_season",
        "upcoming_flag_month": "Oct",
        "flagged_months": ["Oct", "Nov"],
        "flag_reason": "borrower_income_has_declined_during_oct_nov_for_3_consecutive_years",
        "supporting_evidence": [
          "Average income drops 22% during Oct-Nov",
          "Repayment delays historically increase during Oct"
        ]
      },
      "response_404": {
        "error": "borrower_not_found",
        "message": "No borrower exists with the supplied ID.",
        "status_code": 404
      },
      "response_422": {
        "error": "insufficient_history",
        "message": "There is not enough historical data to reliably detect borrower-specific seasonality.",
        "status_code": 422
      }
    },

    "POST /chat/message": {
      "description": "Receives a borrower message, classifies the message, extracts the reported hardship reason, combines the result with borrower-specific cash-flow analysis and seasonal patterns, and determines the prototype action.",
      "owner": "Backend Lead",
      "request_body": {
        "borrower_id": "BOR001",
        "message": "Baadh ne meri fasal barbaad kar di",
        "language": "hi",
        "input_type": "voice"
      },
      "response_200": {
        "borrower_id": "BOR001",
        "intent": "emergency",
        "extracted_reason": "flood destroyed crops",
        "intent_confidence": 0.91,
        "cashflow_assessment": {
          "hardship_classification": "temporary",
          "confidence": 0.88
        },
        "matched_seasonal_flag": true,
        "seasonal_match_type": "upcoming",
        "matched_flag": "lean_season",
        "matched_flag_month": "Oct",
        "action_taken": "auto_relief",
        "decision_explanation": [
          "Emergency detected from borrower message",
          "Reported hardship aligns with the borrower's upcoming historical seasonal risk window",
          "Repayment behavior remained largely consistent",
          "Cash-flow stress is classified as temporary"
        ],
        "payment_plan_updated": true,
        "conversation_id": "CONV0001"
      },
      "response_404": {
        "error": "borrower_not_found",
        "message": "No borrower exists with the supplied ID.",
        "status_code": 404
      },
      "response_500": {
        "error": "claude_api_failure",
        "message": "The language-model service failed while processing the borrower message.",
        "status_code": 500,
        "fallback_action": "escalated"
      }
    },

    "GET /chat/history/{borrower_id}": {
      "description": "Returns the borrower's conversation audit history.",
      "owner": "Backend Lead",
      "path_params": {
        "borrower_id": "string"
      },
      "response_200": {
        "borrower_id": "BOR001",
        "conversations": [
          {
            "conversation_id": "CONV0001",
            "timestamp": "2026-09-16T10:22:00Z",
            "message": "Baadh ne meri fasal barbaad kar di",
            "intent": "emergency",
            "extracted_reason": "flood destroyed crops",
            "action_taken": "auto_relief",
            "seasonal_match_type": "upcoming"
          }
        ]
      },
      "response_404": {
        "error": "borrower_not_found",
        "message": "No borrower exists with the supplied ID.",
        "status_code": 404
      }
    },

    "GET /borrower/{id}/assessment": {
      "description": "Returns a human-readable assessment of the borrower's current condition, evidence and prototype recommended action. This is a system recommendation and does not represent a manual loan-officer decision.",
      "owner": "Backend Lead",
      "path_params": {
        "id": "string"
      },
      "response_200": {
        "borrower_id": "BOR001",
        "final_assessment": "temporary_stress",
        "recommended_action": "defer_one_installment",
        "confidence": 0.91,
        "evidence": [
          {
            "factor": "income_drop",
            "impact": "high",
            "details": "18% below annual average"
          },
          {
            "factor": "historical_seasonality",
            "impact": "high",
            "details": "Observed during previous years"
          },
          {
            "factor": "repayment_behavior",
            "impact": "medium",
            "details": "94% on-time repayment rate"
          }
        ],
        "generated_reasoning": "Current hardship appears seasonal and temporary. Repayment behavior remains strong and there is insufficient evidence of persistent deterioration."
      },
      "response_404": {
        "error": "borrower_not_found",
        "message": "No borrower exists with the supplied ID.",
        "status_code": 404
      }
    },

    "GET /borrower/{id}/payment-plan": {
      "description": "Returns the original and currently adjusted repayment schedule.",
      "owner": "Backend Support",
      "path_params": {
        "id": "string"
      },
      "response_200": {
        "borrower_id": "BOR001",
        "original_schedule": [
          {
            "due_date": "2026-10-01",
            "amount": 2500,
            "status": "pending"
          }
        ],
        "adjusted_schedule": [
          {
            "due_date": "2026-10-01",
            "amount": 0,
            "status": "deferred"
          },
          {
            "due_date": "2027-01-01",
            "amount": 2500,
            "status": "added"
          }
        ],
        "reason_for_adjustment": "Temporary hardship confirmed through cash-flow analysis and emergency event assessment.",
        "updated_by": "decision_engine",
        "updated_at": "2026-09-16T12:00:00Z"
      },
      "response_404": {
        "error": "borrower_not_found",
