# Optional. When unset, NLP uses the deterministic prototype classifier
# so the Raju demo still works offline.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Must stay 2026-09-16 for the hackathon demo (Sep = current normal, Oct = upcoming lean season).
DEMO_DATE=2026-09-16

INTENT_CONFIDENCE_THRESHOLD=0.85
REPAYMENT_CONSISTENCY_THRESHOLD=0.85
PERSISTENT_DECLINE_DURATION_MONTHS=4
