# Backend environment variables
# Copy this to .env and fill in your values

# Groq API key for NLP (intent classification and transcription)
# Get your key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model for intent classification (default: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Groq Whisper model for voice transcription (default: whisper-large-v3)
GROQ_WHISPER_MODEL=whisper-large-v3

# Demo date for consistent seasonal pattern detection (YYYY-MM-DD)
DEMO_DATE=2026-09-16

# Analysis configuration
HISTORY_WINDOW_MONTHS=12
SEASONALITY_MINIMUM_HISTORY_MONTHS=12
SEASONALITY_LOOKAHEAD_MONTHS=3
INTENT_CONFIDENCE_THRESHOLD=0.85
REPAYMENT_CONSISTENCY_THRESHOLD=0.85
PERSISTENT_DECLINE_DURATION_MONTHS=4
INCOME_DROP_THRESHOLD_PCT=-10.0
SEASONALITY_DEVIATION_PCT=15.0
